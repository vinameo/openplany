    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.58.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.2"
  }
}

