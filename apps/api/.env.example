NODE_ENV=development
PORT=3000
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# Matches the postgres service in docker-compose.yaml (exposed on localhost)
DATABASE_URL=postgresql://openplany:openplany@localhost:5432/openplany
DB_LOGGING=false
DB_MIGRATIONS_RUN=false

REDIS_URL=redis://localhost:6379

# Auth (login). Generate a secret with: openssl rand -base64 48
AUTH_HMAC_SECRET=change-me-to-a-random-secret-of-32-chars-or-more
# false if your dev browser rejects Secure cookies on http://localhost
SESSION_COOKIE_SECURE=true
SESSION_TTL_DAYS=7
SESSION_ABSOLUTE_TTL_DAYS=30
TRUST_PROXY=false

JWT_SECRET=change-me
LOG_LEVEL=debug
