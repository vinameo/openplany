# Optional overrides for docker-compose.yaml — copy to .env at the repo root.
# The API's own config lives in apps/api/.env (see apps/api/.env.example).
POSTGRES_USER=openplany
POSTGRES_PASSWORD=openplany
POSTGRES_DB=openplany
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=3000
CORS_ORIGIN=http://localhost:5173
# Generate with: openssl rand -base64 48
AUTH_HMAC_SECRET=
SESSION_COOKIE_SECURE=false
TRUST_PROXY=false
