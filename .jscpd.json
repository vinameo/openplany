{
  "$schema": "https://json.schemastore.org/jscpd.json",
  "path": [
    "apps/api/src",
    "apps/web/src",
    "packages/contracts/src",
    "packages/ui/src"
  ],
  "format": ["typescript", "tsx", "css"],
  "ignore": [
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/test/**",
    "**/database/migrations/**"
  ],
  "minLines": 10,
  "minTokens": 70,
  "reporters": ["console"],
  "gitignore": true,
  "threshold": 2.0,
  "silent": false
}
